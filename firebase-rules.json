{
  "rules": {
    "rooms": { ".read": true, ".write": true },
    "matchmaking": { ".read": true, ".write": true },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "leaderboard": {
      ".read": true,
      ".indexOn": ["wins"],
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['name','wins'])"
      }
    }
  }
}
